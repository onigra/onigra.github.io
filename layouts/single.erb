<%= render_partial "header" %>
<main>
  <article class="content">
    <% if @page[:date] %>
    <p><a href="/post/">&larr; Archives</a></p>
    <% end %>
    <header>
      <% if @page[:date] %>
      <p><%= @page[:date].strftime("%Y.%m.%d") %></p>
      <% end %>
      <h1><%= @page[:title] %></h1>
    </header>
    <div>
      <%= @page[:content] %>
    </div>
    <% if @site[:params]["sharingicons"] %>
    <%= render_partial "sharing" %>
    <% end %>
    <% if @page[:date] %>
    <%= render_partial "post_nav" %>
    <% end %>
  </article>
</main>
<%= render_partial "footer" %>
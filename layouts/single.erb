<%= render_partial "header" %>
<%= render_partial "nav" %>
<section class="section">
  <div class="container">
    <h1 class="title"><%= @page[:title] %></h1>
    <% if @page[:date] %>
    <h2 class="subtitle is-5"><%= @page[:date].strftime("%B %-d, %Y") %> by <%= @site[:author] %></h2>
    <% end %>
    <div class="content">
      <%= @page[:content] %>
    </div>
    <% if @site[:params]["sharingicons"] %>
    <%= render_partial "sharing" %>
    <% end %>
  </div>
</section>
<%= render_partial "footer" %>

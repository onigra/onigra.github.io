<%= render_partial "header" %>
<main>
  <div class="content">
    <% @grouped_by_year.each do |year, entries| %>
      <h2><%= year %></h2>
      <ul>
        <% entries.each do |entry| %>
        <li>
          <a href="<%= entry[:url] %>"><%= entry[:title] %></a>
          <% if entry[:date] %>
          <%= entry[:date].strftime("%Y.%m.%d") %>
          <% end %>
        </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</main>
<%= render_partial "footer" %>
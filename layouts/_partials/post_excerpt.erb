<article class="post-excerpt">
  <h1 class="title"><a href="<%= @entry[:url] %>"><%= @entry[:title] %></a></h1>

  <% if @entry[:date] %>
  <h2 class="subtitle is-5"><%= @entry[:date].strftime("%B %-d, %Y") %></h2>
  <% end %>

  <p class="summary"><%= @entry[:summary] %></p>
  <% if @entry[:has_more] %>
    <p><a href="<%= @entry[:url] %>" class="read-more">Read more</a></p>
  <% end %>
</article>

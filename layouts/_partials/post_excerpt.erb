<article class="post-excerpt">
  <% if @entry[:date] %>
  <p class="post-excerpt__date"><%= @entry[:date].strftime("%Y.%m.%d") %></p>
  <% end %>
  <h2 class="post-title post-title--list"><a href="<%= @entry[:url] %>"><%= @entry[:title] %></a></h2>
  <p class="post-excerpt__summary"><%= @entry[:summary] %></p>
</article>

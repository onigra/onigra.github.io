<nav class="pager content-wrap" aria-label="Pagination">
  <% if @paginator[:prev] %>
  <a class="pager__link pager__link--prev" href="<%= @paginator[:prev] %>">← Newer</a>
  <% else %>
  <span></span>
  <% end %>
  <% if @paginator[:next] %>
  <a class="pager__link pager__link--next" href="<%= @paginator[:next] %>">Older →</a>
  <% end %>
</nav>

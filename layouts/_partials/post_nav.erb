<nav aria-label="Post navigation">
  <div>
    <% if @prev_post %>
    <p>&larr; Prev</p>
    <p><a href="<%= @prev_post[:url] %>"><%= @prev_post[:title] %></a></p>
    <% end %>
  </div>
  <div>
    <% if @next_post %>
    <p>Next &rarr;</p>
    <p><a href="<%= @next_post[:url] %>"><%= @next_post[:title] %></a></p>
    <% end %>
  </div>
</nav>
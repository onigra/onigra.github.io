<section class="section">
  <div class="container">
    <nav class="nav">
      <div class="nav-left">
        <a class="nav-item" href="<%= @site[:base_url] %>/"><h1 class="title is-4"><%= @site[:title] %></h1></a>
        <nav class="nav-item level is-mobile">
          <% Array(@site[:params]["menu"]).each do |item| %>
          <a class="level-item" href="<%= item["url"] %>"><%= item["title"] %></a>
          <% end %>
        </nav>
      </div>
      <div class="nav-right">
        <nav class="nav-item level is-mobile">
          <% Array(@site[:params]["social"]).each do |item| %>
          <a class="level-item" href="<%= item["url"] %>" target="_blank">
            <span class="icon">
              <i class="fa <%= item["fa_icon"] %>"></i>
            </span>
          </a>
          <% end %>
        </nav>
      </div>
    </nav>
  </div>
</section>

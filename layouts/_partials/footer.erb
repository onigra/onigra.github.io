<footer>
  <div class="content">
    <p><%= @site[:params]["copyright"] %></p>
  </div>
</footer>

<% hljs_version = @site[:params].dig("highlight", "version") %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/<%= hljs_version %>/highlight.min.js" crossorigin="anonymous"></script>
<% Array(@site[:params].dig("highlight", "languages")).each do |lang| %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/<%= hljs_version %>/languages/<%= lang %>.min.js" crossorigin="anonymous"></script>
<% end %>
<script>hljs.highlightAll();</script>
</body>
</html>
